# Supabase Connection URI (Recommended)
# You can copy this directly from your Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.your_project_ref:your_supabase_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alternatively, configure individual parameters:
# DB_NAME=postgres
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_supabase_password
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require

# Django Configuration
